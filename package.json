{
  "name": "@jesselpalmer/easy-blob",
  "version": "2.0.0-rc.1",
  "description": "Local file storage with an HTTP API, SQLite metadata, and explicit recovery",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "examples/",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "ROADMAP.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/clean.cjs && tsc",
    "dev": "tsc --watch",
    "start": "node -e \"console.log('Library package: see README.md and examples/server.cjs')\"",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:package": "npm run build && node scripts/verify-package.cjs",
    "lint:md": "markdownlint \"*.md\" \"docs/**/*.md\" \"examples/**/*.md\"",
    "lint:md:fix": "markdownlint --fix \"*.md\" \"docs/**/*.md\" \"examples/**/*.md\"",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.cjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.cjs\"",
    "lint": "npm run lint:md && npm run format:check",
    "check": "npm run build && npm run lint && npm test && node scripts/verify-package.cjs",
    "audit:runtime": "npm audit --omit=dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jesselpalmer/easy-blob.git"
  },
  "keywords": [
    "blob",
    "storage",
    "file-upload",
    "file-storage",
    "local-storage",
    "express",
    "typescript",
    "sqlite",
    "multer"
  ],
  "author": "Jesse Palmer",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jesselpalmer/easy-blob/issues"
  },
  "homepage": "https://github.com/jesselpalmer/easy-blob#readme",
  "dependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "markdownlint-cli": "^0.50.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1"
  }
}
