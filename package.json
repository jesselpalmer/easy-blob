{
  "name": "@jesselpalmer/easy-blob",
  "version": "2.0.0-rc.1",
  "description": "Local file storage with an HTTP API, SQLite metadata, and explicit recovery",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "examples/",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "ROADMAP.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/clean.cjs && tsc",
    "dev": "tsc --watch",
    "start": "node -e \"console.log('Library package: see README.md and examples/server.cjs')\"",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "test": "npm run typecheck:tests && vitest run",
    "test:coverage": "npm run typecheck:tests && vitest run --coverage",
    "test:package": "npm run test:e2e",
    "lint:md": "markdownlint \"*.md\" \"docs/**/*.md\" \"examples/**/*.md\"",
    "lint:md:fix": "markdownlint --fix \"*.md\" \"docs/**/*.md\" \"examples/**/*.md\"",
    "format": "prettier --write \"{src,tests,scripts,examples}/**/*.{ts,cts,mts,js,cjs,mjs,json}\" \"*.{ts,cts,mts,js,cjs,mjs,json}\" \".github/**/*.yml\" .prettierrc .markdownlint.json",
    "format:check": "prettier --check \"{src,tests,scripts,examples}/**/*.{ts,cts,mts,js,cjs,mjs,json}\" \"*.{ts,cts,mts,js,cjs,mjs,json}\" \".github/**/*.yml\" .prettierrc .markdownlint.json",
    "lint": "npm run lint:code && npm run lint:md && npm run format:check",
    "check": "npm run build && npm run lint && npm run test:coverage && npm run test:tooling && node scripts/verify-package.cjs",
    "audit:runtime": "npm audit --omit=dev",
    "test:unit": "npm run typecheck:tests && vitest run --project unit",
    "test:integration": "npm run typecheck:tests && vitest run --project integration",
    "test:e2e": "npm run build && node scripts/verify-package.cjs",
    "lint:code": "eslint . --max-warnings=0",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "test:tooling": "node --test tests/tooling/dependencies.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jesselpalmer/easy-blob.git"
  },
  "keywords": [
    "blob",
    "storage",
    "file-upload",
    "file-storage",
    "local-storage",
    "express",
    "typescript",
    "sqlite",
    "multer"
  ],
  "author": "Jesse Palmer",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jesselpalmer/easy-blob/issues"
  },
  "homepage": "https://github.com/jesselpalmer/easy-blob#readme",
  "dependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/multer": "^2.3.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "markdownlint-cli": "^0.50.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1"
  },
  "overrides": {
    "minimatch": "11.0.3",
    "markdownlint": {
      "re2js": "2.8.7"
    },
    "micromark-extension-math": {
      "katex": "0.18.2"
    }
  }
}
